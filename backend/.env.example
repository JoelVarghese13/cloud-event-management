# Server Configuration
PORT=3000
NODE_ENV=development

# AWS Configuration
AWS_REGION=ap-south-1

# JWT Secret for Authentication
JWT_SECRET=your-secure-jwt-secret-key-change-this-in-production

# AWS Resource Identifiers (Populated automatically by deployment scripts)
# SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/event-registration-queue
# FLYERS_BUCKET=event-mgmt-flyers-123456789012

# Optional Local Database Fallback (When not using AWS SSM Parameter Store)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=admin
# DB_PASSWORD=YourSecurePassword123!
# DB_NAME=eventmgmt
